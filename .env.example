# Скопируйте в .env и подставьте свои значения.
#
# Вариант 1 – прокси-сервис, отдающий Anthropic-совместимый API
# (авторизация через заголовок Authorization: Bearer)
ANTHROPIC_BASE_URL=https://cheapvibecode.ru
ANTHROPIC_AUTH_TOKEN=

# Вариант 2 – прямой доступ к Anthropic (заголовок x-api-key).
# Оставьте ANTHROPIC_BASE_URL пустым и заполните только ключ:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Модель для анализа. Без неё берётся claude-opus-5.
RECOIN_MODEL=claude-opus-5

# Включается только на хостинге с HTTPS. Помечает сессионную куку флагом
# secure. При локальном запуске по HTTP оставьте переменную пустой,
# иначе браузер не сохранит куку и вход работать не будет.
RECOIN_HTTPS=
