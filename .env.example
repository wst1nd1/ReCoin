# Скопируйте в .env и подставьте свои значения.
#
# Вариант 1 – прокси-сервис, отдающий Anthropic-совместимый API
# (авторизация через заголовок Authorization: Bearer)
ANTHROPIC_BASE_URL=https://cheapvibecode.ru
ANTHROPIC_AUTH_TOKEN=

# Вариант 2 – прямой доступ к Anthropic (заголовок x-api-key).
# Оставьте ANTHROPIC_BASE_URL пустым и заполните только ключ:
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Модель для анализа. Без неё берётся claude-opus-5.
RECOIN_MODEL=claude-opus-5

# Включается только на хостинге с HTTPS. Помечает сессионную куку флагом
# secure. При локальном запуске по HTTP оставьте переменную пустой,
# иначе браузер не сохранит куку и вход работать не будет.
RECOIN_HTTPS=

# Письма с кодом восстановления пароля. Пока ничего не заполнено, письма не
# уходят, а код пишется в журнал сервера.
#
# Способ 1, основной – почтовый сервис Brevo. Отправка идёт обычными
# веб-запросами, поэтому работает у провайдеров, закрывающих почтовые порты,
# и на бесплатных тарифах хостингов. Ключ создаётся в личном кабинете,
# адрес отправителя там же подтверждается письмом.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=ReCoin

# Способ 2, запасной – прямое соединение с почтовым сервером. Многие
# провайдеры и хостинги закрывают эти порты. Для Gmail нужен пароль
# приложения, обычный пароль от учётной записи не подойдёт.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
